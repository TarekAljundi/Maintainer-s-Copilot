VAULT_ADDR=http://vault:8200
VAULT_TOKEN=

API_PORT=8000
STREAMLIT_PORT=8501
WIDGET_PORT=8088
HOST_PORT=8087
HOST_BLOCKED_PORT=8089
LANGFUSE_PORT=3000
MODEL_SERVER_PORT=8001

POSTGRES_USER=copilot
POSTGRES_DB=copilot
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# LLM provider switch. Defaults to groq. Set to 'openrouter' to use
# nvidia/nemotron-3-super-120b-a12b:free as the chat / summarizer / RAGAS LLM.
# Override the default model with LLM_MODEL=... if needed.
LLM_PROVIDER=groq
LLM_MODEL=

# Provider API keys. The active provider's key must be non-placeholder; the
# inactive provider's key can stay 'placeholder'. Both are seeded into
# Vault path secret/api/llm.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Langfuse self-host project keys. Get them after first-boot bootstrap (see
# RUNBOOK §Langfuse first-run). Seeded into Vault path secret/api/tracing by
# the vault-init container. Leaving them empty/placeholder keeps the api in
# tracing-disabled mode (no spans sent, boot check #6 is a no-op).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
